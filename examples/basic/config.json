{
  "tasks": [
    {
      "kind": "job",
      "name": "prepare",
      "phase": "startup",
      "timeout": "5s",
      "command": ["sh", "-c", "printf '%s\\n' \"$DEMO_MESSAGE\" > /srv/index.html"]
    },
    {
      "kind": "process",
      "name": "application",
      "phase": "startup",
      "on_exit": "restart-container",
      "command": ["demo", "serve"]
    },
    {
      "kind": "check",
      "name": "ready",
      "phase": "after-start",
      "deadline": "20s",
      "interval": "1s",
      "command": ["demo", "check"]
    },
    {
      "kind": "check",
      "name": "http",
      "interval": "${CHECK_INTERVAL:-1s}",
      "timeout": "2s",
      "failures": 3,
      "command": ["demo", "check"]
    },
    {
      "kind": "job",
      "name": "maintenance",
      "interval": "30s",
      "timeout": "5s",
      "command": ["sh", "-c", "echo Maintenance: $(date -u)"]
    }
  ]
}
